[importlinter]
root_packages =
    vectra_verification
include_external_packages = True

# NFR-U12-01, Paso 1 (y U12-T02: `playwright`, `jwt` y `pyarrow` tambien): `sampler`, `report`, `story_map` y `rt2_latency` no hacen E/S: ni red, ni procesos, ni asincronia, ni los modulos con E/S de la
# unidad. `story_map` lee su archivo con `pathlib` (P-3); `yaml` se prohibe aqui a los otros tres y se permite solo en `story_map`.
[importlinter:contract:logica-pura-sin-es]
name = sampler, report, story_map y rt2_latency no hacen E/S
type = forbidden
source_modules =
    vectra_verification.sampler
    vectra_verification.report
    vectra_verification.story_map
    vectra_verification.rt2_latency
forbidden_modules =
    httpx
    requests
    socket
    subprocess
    asyncio
    pyotp
    playwright
    jwt
    pyarrow
    vectra_verification.credentials
    vectra_verification.evidence
    vectra_verification.manifest
    vectra_verification.simulator
    vectra_verification.driver
    vectra_verification.cli
    vectra_verification.store
    vectra_verification.live
    vectra_verification.clients
    vectra_verification.scenarios
    vectra_verification.load

# P-3: `yaml` solo en `story_map`.
[importlinter:contract:yaml-solo-en-story-map]
name = sampler, report y rt2_latency no importan yaml
type = forbidden
source_modules =
    vectra_verification.sampler
    vectra_verification.report
    vectra_verification.rt2_latency
forbidden_modules =
    yaml

# Paso 1: U12 no depende de `vectra_common` (la imagen no la lleva). Esta instalada en el entorno del workspace: sin este contrato, un import
# accidental pasaria aqui y fallaria en la imagen.
[importlinter:contract:sin-vectra-common]
name = ningun modulo importa vectra_common
type = forbidden
source_modules =
    vectra_verification
forbidden_modules =
    vectra_common

# U12-T02: cada biblioteca con E/S o con navegador entra por un solo archivo. `allow_indirect_imports`: `driver` importa `simulator` (que importa `pyarrow`) y no por eso rompe el contrato.
# `playwright` solo en `clients.oidc`.
[importlinter:contract:playwright-solo-en-oidc]
name = playwright solo en clients.oidc
type = forbidden
source_modules =
    vectra_verification.guard
    vectra_verification.credentials
    vectra_verification.evidence
    vectra_verification.clock
    vectra_verification.sampler
    vectra_verification.report
    vectra_verification.story_map
    vectra_verification.rt2_latency
    vectra_verification.simulator
    vectra_verification.driver
    vectra_verification.manifest
    vectra_verification.cli
    vectra_verification.scenarios
    vectra_verification.load
    vectra_verification.clients._api
    vectra_verification.clients.gateway
    vectra_verification.clients.bff
    vectra_verification.clients.registry
    vectra_verification.clients.prom
    vectra_verification.clients.loki
    vectra_verification.clients.k8s_read
forbidden_modules =
    playwright
allow_indirect_imports = True

# `kubectl` se invoca desde un solo archivo, que es el que mira la prueba de verbos: `subprocess` solo en `clients.k8s_read`.
[importlinter:contract:subprocess-solo-en-k8s-read]
name = subprocess solo en clients.k8s_read
type = forbidden
source_modules =
    vectra_verification.guard
    vectra_verification.credentials
    vectra_verification.evidence
    vectra_verification.clock
    vectra_verification.sampler
    vectra_verification.report
    vectra_verification.story_map
    vectra_verification.rt2_latency
    vectra_verification.simulator
    vectra_verification.driver
    vectra_verification.manifest
    vectra_verification.cli
    vectra_verification.scenarios
    vectra_verification.load
    vectra_verification.clients._api
    vectra_verification.clients.oidc
    vectra_verification.clients.gateway
    vectra_verification.clients.bff
    vectra_verification.clients.registry
    vectra_verification.clients.prom
    vectra_verification.clients.loki
forbidden_modules =
    subprocess
allow_indirect_imports = True

# `pyarrow` solo en `simulator` (la particion `test` de U5).
[importlinter:contract:pyarrow-solo-en-simulator]
name = pyarrow solo en simulator
type = forbidden
source_modules =
    vectra_verification.guard
    vectra_verification.credentials
    vectra_verification.evidence
    vectra_verification.clock
    vectra_verification.driver
    vectra_verification.manifest
    vectra_verification.cli
    vectra_verification.scenarios
    vectra_verification.load
    vectra_verification.clients
forbidden_modules =
    pyarrow
allow_indirect_imports = True

# U12-T03: los escenarios no hacen E/S por su cuenta: toda la E/S pasa por `clients/` y `simulator`. `allow_indirect_imports`: `scenarios` importa `clients` (que importa `httpx`) y `simulator` (que importa `pyarrow`) y no por eso rompe el contrato.
[importlinter:contract:escenarios-sin-es-propia]
name = scenarios no importa httpx, requests, socket, subprocess, playwright ni pyarrow
type = forbidden
source_modules =
    vectra_verification.scenarios
forbidden_modules =
    httpx
    requests
    socket
    subprocess
    playwright
    pyarrow
allow_indirect_imports = True

# U12-T04: `store` es el UNICO escritor de la carpeta de la verificacion y solo lo importan `cli` y `manifest` (que recibe un `Store`, no escribe). Nadie mas de `src/` lo alcanza: una escritura directa en otro modulo
# la ve ademas la prueba estatica de `test_store.py`.
[importlinter:contract:store-solo-para-cli-y-manifest]
name = store solo lo importan cli y manifest
type = forbidden
source_modules =
    vectra_verification.guard
    vectra_verification.credentials
    vectra_verification.clock
    vectra_verification.sampler
    vectra_verification.report
    vectra_verification.story_map
    vectra_verification.rt2_latency
    vectra_verification.simulator
    vectra_verification.driver
    vectra_verification.live
    vectra_verification.scenarios
    vectra_verification.clients
    vectra_verification.load
forbidden_modules =
    vectra_verification.store

# U12-T04: `cli` es el UNICO que junta `scenarios`, `driver` y `store`. `manifest` (datos y texto del informe) no conoce los escenarios ni el conductor ni los clientes, y `live` (el mundo real) no conoce a `cli` ni a `store`.
[importlinter:contract:manifest-y-live-no-juntan-escenarios-y-store]
name = manifest no importa scenarios, driver, clients, simulator, cli ni live
type = forbidden
source_modules =
    vectra_verification.manifest
forbidden_modules =
    vectra_verification.scenarios
    vectra_verification.driver
    vectra_verification.clients
    vectra_verification.simulator
    vectra_verification.cli
    vectra_verification.live

[importlinter:contract:live-sin-cli-ni-store]
name = live no importa cli ni store
type = forbidden
source_modules =
    vectra_verification.live
forbidden_modules =
    vectra_verification.cli
    vectra_verification.store
    vectra_verification.manifest

# U12-T04: la seccion `u11` y las evidencias de las demos no hacen E/S por su cuenta (lo que lee entra por `clients.prom`; las derivaciones de `demos` y la retoma de `resume` son puras).
[importlinter:contract:u11-demos-y-resume-sin-es]
name = scenarios.u11, scenarios.demos y scenarios.resume no importan httpx, socket, subprocess, playwright ni pyarrow directo
type = forbidden
source_modules =
    vectra_verification.scenarios.u11
    vectra_verification.scenarios.demos
    vectra_verification.scenarios.resume
forbidden_modules =
    httpx
    requests
    socket
    subprocess
    playwright
    pyarrow
allow_indirect_imports = True
